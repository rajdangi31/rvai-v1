{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rvai.local/contracts/command_outcome.schema.json",
  "title": "CommandOutcome",
  "type": "object",
  "required": ["result", "message"],
  "properties": {
    "result": {
      "type": "string",
      "enum": ["confirmed", "blocked", "failed", "unconfirmed", "clarification"]
    },
    "message": { "type": "string" },
    "request_id": { "type": "string" },
    "target": { "type": ["string", "null"] },
    "cmd": {
      "type": ["string", "null"],
      "enum": ["ON", "OFF", "STATUS", null]
    },
    "actual": {
      "type": ["string", "null"],
      "enum": ["ON", "OFF", null]
    },
    "fault": { "type": ["string", "null"] },
    "fault_available": { "type": "boolean" },
    "fresh": { "type": "boolean" },
    "reason_code": { "type": ["string", "null"] },
    "candidates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "audio_path": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
