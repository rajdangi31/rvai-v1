# Copy to .env and adjust for local / Jetson deployment (V1).

# Local LLM (Ollama, llama.cpp server, LM Studio)
RVAI_LLM_BASE_URL=http://127.0.0.1:11434/v1
RVAI_LLM_MODEL=qwen3.5:4b
RVAI_LLM_TIMEOUT_SECONDS=60
RVAI_LLM_API_KEY=ollama
RVAI_LLM_REASONING_EFFORT=none
# RVAI_LLM_DEBUG=true

# Whisper STT: stub | openai_compatible | faster_whisper | whisper_cpp
RVAI_STT_BACKEND=stub
RVAI_STT_BASE_URL=http://127.0.0.1:8080/v1
RVAI_STT_MODEL=whisper-1
RVAI_STT_LANGUAGE=en
RVAI_FASTER_WHISPER_MODEL=base.en
RVAI_FASTER_WHISPER_DEVICE=cpu
RVAI_FASTER_WHISPER_COMPUTE_TYPE=int8
RVAI_FFMPEG_BINARY=ffmpeg
RVAI_WHISPER_CLI_BINARY=whisper-cli
# RVAI_WHISPER_MODEL_PATH=D:/path/to/ggml-base.en.bin

# Piper TTS: stub | piper
RVAI_TTS_BACKEND=stub
RVAI_PIPER_BINARY=piper
# RVAI_PIPER_MODEL_PATH=/opt/piper/en_US-lessac-medium.onnx
RVAI_TTS_PLAY=false

# JSON <-> Matter Translator: chip_tool | matter_server (no product simulator)
RVAI_MATTER_BACKEND=chip_tool
RVAI_MATTER_SERVER_WS_URL=ws://127.0.0.1:5580/ws
RVAI_CHIP_TOOL_BINARY=chip-tool
RVAI_CONFIRM_TIMEOUT_SECONDS=5.0
RVAI_MATTER_RECONNECT_SECONDS=2.0

# Limits
RVAI_MAX_TEXT_CHARS=500
RVAI_MAX_AUDIO_SECONDS=30
RVAI_MAX_AUDIO_BYTES=5000000

# Target Registry
RVAI_TARGETS_PATH=config/targets.yaml
